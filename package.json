{
  "name": "gates",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-scene.mjs && astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check:scene": "node scripts/validate-scene.mjs",
    "optimize:glb": "gltf-transform optimize public/3d-src/$npm_config_name.glb public/3d/$npm_config_name.glb --compress meshopt --texture-compress ktx2"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.180.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^6.0.3"
  }
}
