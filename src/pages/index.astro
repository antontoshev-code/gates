---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stop from '../components/Stop.astro';
import ContactForm from '../components/ContactForm.astro';
import BriefForm from '../components/BriefForm.astro';
import type { TourData, Pose } from '../tour/types';

const stops = (await getCollection('stops')).sort((a, b) => a.data.order - b.data.order);
const worlds = (await getCollection('worlds')).sort((a) => (a.data.side === 'left' ? -1 : 1));
const [dialogue] = await getCollection('dialogue');
const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const poses = await getCollection('anthony');
const inWorld = (w: string) => stops.filter((s) => s.data.world === w);

const tourData: TourData = {
  stops: stops.map((s) => ({ id: s.id, world: s.data.world, order: s.data.order, title: s.data.title, place: s.data.place, say: s.data.say, picture: s.data.picture })),
  worlds: worlds.map((w) => ({ ...w.data })),
  dialogue: dialogue.data,
  faq: faq.map((f) => ({ q: f.data.question, a: (f.body ?? '').trim() })),
  anthony: Object.fromEntries(poses.map((p) => [p.id, p.data.src])) as Record<Pose, string>,
};
const chevron = (d: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
---
<Base>
  <a class="skip" href="?tier=plain">Read it as a plain page</a>

  <!-- the world: a 3D scene (tier-3d) or pictures (tier-25d). Decorative; everything in it has an HTML twin. -->
  <div id="stage" aria-hidden="true">
    <canvas id="three"></canvas>
    <div id="pics"></div>
  </div>

  <div id="loader" aria-hidden="true">
    <span>Opening the gates</span>
    <span class="count" id="load-n">0%</span>
  </div>

  <header class="topbar">
    <a class="logo" href="#threshold"><i aria-hidden="true"></i><span>Anthony Toshev</span></a>
    <div class="top-r">
      <a class="quick walk-only" href="?tier=plain">Read as a page</a>
      <a class="quick plain-only" href="?tier=walk">Walk through it</a>
      <a class="quick" href="#contact">Write to me</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <i></i><i></i><i></i>
      </button>
    </div>
  </header>

  <!-- the walk's controls, over the scene -->
  <div id="hud" class="walk-only">
    <div id="hotspots">
      {stops.map((s) => (
        <button type="button" class={`hot ${s.data.world}`} data-stop={s.id} data-world={s.data.world}>
          <span class="ring" aria-hidden="true"></span><span class="tip">{s.data.title}</span>
        </button>
      ))}
    </div>
    <div id="gates" role="group" aria-label="Choose a gate">
      {worlds.map((w) => (
        <button type="button" class={`gate ${w.id}`} data-gate={w.id}><b>{w.data.gate}</b><em>{w.data.hint}</em></button>
      ))}
    </div>
    <section id="bubble" aria-label="Anthony says" aria-live="polite" hidden>
      <button class="close" type="button" aria-label="Close. Ask Anthony stays in the corner.">
        <Fragment set:html={chevron('M6 6l12 12M18 6L6 18')} />
      </button>
      <p class="who">Anthony</p>
      <div class="lines"></div>
      <div class="choices"></div>
    </section>
    <button id="ask" type="button" hidden><img src={tourData.anthony.welcome} alt="" width="28" height="42" /><span>Ask Anthony</span></button>
    <nav id="walknav" aria-label="Walk">
      <button type="button" class="arrow" id="prev" aria-label="Back"><Fragment set:html={chevron('M15 18l-6-6 6-6')} /></button>
      {worlds.map((w) => (
        <div class={`dots ${w.id}`} data-world={w.id}>
          <button type="button" data-to="threshold">Gates</button>
          {inWorld(w.id).map((s) => <button type="button" data-to={s.id}>{s.data.title}</button>)}
        </div>
      ))}
      <span class="at-gate">The gates</span>
      <button type="button" class="arrow" id="next" aria-label="Walk in"><Fragment set:html={chevron('M9 18l6-6-6-6')} /></button>
    </nav>
    <p id="hint" aria-hidden="true">Scroll, swipe or use the arrow keys. One step at a time.</p>
    <p id="announce" class="sr-only" aria-live="polite"></p>
  </div>

  <!-- the words: all of them, in reading order. The plain page shows them as a page; the walk shows one at a time. -->
  <main id="content">
    <section class="intro" id="threshold" aria-labelledby="hello">
      <img class="me" src={tourData.anthony.welcome} alt="Anthony Toshev, arms wide open, smiling" width="400" height="600" />
      <div class="intro-text">
        <h1 id="hello">{dialogue.data.greeting[0]}</h1>
        {dialogue.data.greeting.slice(1).map((l) => <p class="lede">{l}</p>)}
        <div class="gate-links">
          {worlds.map((w) => (
            <a class={`gate-link ${w.id}`} href={`#world-${w.id}`}><b>{w.data.gate}</b><span>{w.data.hint}</span></a>
          ))}
        </div>
      </div>
    </section>

    {worlds.map((w) => (
      <section class={`world ${w.id}`} id={`world-${w.id}`} aria-labelledby={`h-${w.id}`}>
        <h2 id={`h-${w.id}`} class="world-h">{w.data.label}</h2>
        {inWorld(w.id).map((s) => <Stop stop={s} total={inWorld(w.id).length} worldLabel={w.data.label} />)}
      </section>
    ))}

    <section class="faq" id="faq" aria-labelledby="h-faq">
      <h2 id="h-faq">Questions people ask</h2>
      {faq.map((f) => (
        <details><summary>{f.data.question}</summary><p>{f.body}</p></details>
      ))}
    </section>

    <section class="sheet" id="contact" aria-labelledby="h-contact">
      <button class="panel-close" type="button" aria-label="Close and go back"><Fragment set:html={chevron('M6 6l12 12M18 6L6 18')} /></button>
      <h2 id="h-contact" tabindex="-1">Write to me like a person.</h2>
      <p class="sum">Tell me what you're dealing with. I answer within a couple of days, in English or Bulgarian.</p>
      <ContactForm />
    </section>

    <section class="sheet" id="brief" aria-labelledby="h-brief">
      <button class="panel-close" type="button" aria-label="Close and go back"><Fragment set:html={chevron('M6 6l12 12M18 6L6 18')} /></button>
      <h2 id="h-brief" tabindex="-1">Start a brief</h2>
      <p class="sum">Takes two minutes. I come back with questions and a price range. No sales call needed.</p>
      <BriefForm />
    </section>

    <footer class="foot">Anthony Toshev · Sofia, Bulgaria · People and systems</footer>
  </main>

  <nav class="menu" id="menu" aria-label="Everything on this site" hidden>
    <div class="menu-in">
      {worlds.map((w) => (
        <div class="col">
          <a class={`mh ${w.id}`} href={`#${inWorld(w.id)[0].id}`}>{w.data.label}</a>
          {inWorld(w.id).map((s) => <a href={`#${s.id}`}><span class="mplace">{s.data.place}</span>{s.data.title}</a>)}
        </div>
      ))}
      <div class="menu-foot">
        <a href="#threshold">Back to the gates</a>
        <a href="#faq">Questions</a>
        <a href="#contact">Write to me</a>
      </div>
    </div>
  </nav>

  <script type="application/json" id="tour-data" set:html={JSON.stringify(tourData)} />
  <script>
    import { boot } from '../tour/boot';
    boot();
  </script>
</Base>

<style is:global>
  /* ============ shared ============ */
  .skip { position: absolute; left: 12px; top: -60px; z-index: 200; background: var(--fg); color: var(--bg); padding: 10px 14px; border-radius: 999px; font-weight: 600; text-decoration: none; }
  .skip:focus { top: 12px; }
  .topbar { position: fixed; z-index: 40; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center;
    padding: max(14px, env(safe-area-inset-top, 0px)) max(18px, env(safe-area-inset-right, 0px)) 14px max(18px, env(safe-area-inset-left, 0px)); pointer-events: none; }
  .topbar > * { pointer-events: auto; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 16px; text-shadow: 0 2px 14px var(--shadow-strong); }
  .logo i { width: 9px; height: 9px; background: var(--warm); box-shadow: 9px 0 0 var(--cool); margin-right: 9px; }
  .top-r { display: flex; align-items: center; gap: 10px; }
  .quick { font: 600 13px var(--font-body); text-decoration: none; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); min-height: 36px; display: inline-flex; align-items: center; }
  .menu-btn { width: 48px; height: 44px; background: none; border: 0; cursor: pointer; display: grid; align-content: center; justify-items: end; gap: 7px; padding: 0; }
  .menu-btn i { display: block; height: 2px; width: 30px; background: var(--fg); border-radius: 2px; box-shadow: 0 1px 8px var(--light-35); transform-origin: right; transition: transform 0.4s var(--ease), opacity 0.3s; }
  .menu-btn i:nth-child(2) { transform: scaleX(0.76); }
  .menu-btn[aria-expanded='true'] i:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] i:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  .menu { position: fixed; inset: 0; z-index: 35; background: var(--glass-deep); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); overflow-y: auto; }
  .menu-in { max-width: 1000px; margin: 0 auto; padding: 110px max(20px, env(safe-area-inset-right, 0px)) 60px max(20px, env(safe-area-inset-left, 0px)); display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .menu .col { display: grid; gap: 4px; align-content: start; }
  .menu a { text-decoration: none; display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px solid var(--glass-line); font-family: var(--font-display); font-size: 22px; font-weight: 700; }
  .menu a:hover { color: var(--fg-2); }
  .mplace { font: 400 13px var(--font-body); color: var(--muted); }
  .menu .mh { font-size: clamp(36px, 5vw, 60px); font-weight: 800; letter-spacing: -0.04em; border: 0; }
  .menu .mh.human { color: var(--warm-soft); } .menu .mh.tech { color: var(--cool-soft); }
  .menu-foot { grid-column: 1 / -1; display: flex; gap: 24px; flex-wrap: wrap; }
  .menu-foot a { border: 0; font: 600 15px var(--font-body); color: var(--muted); }

  .sheet h2, .faq h2 { font-size: clamp(28px, 3vw, 40px); font-weight: 800; letter-spacing: -0.035em; outline: none; }
  .sheet { display: grid; gap: 14px; position: relative; min-width: 0; }
  .panel-close { position: absolute; top: 0; right: 0; width: 44px; height: 44px; display: none; place-items: center; border: 0; border-radius: 50%; background: var(--light-12); color: var(--fg); cursor: pointer; }
  .panel-close:hover { background: var(--light-20); }
  .sheet .sum { color: var(--fg-2); }
  .faq details { border-bottom: 1px solid var(--line); padding: 14px 0; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { color: var(--fg-2); margin-top: 8px; }

  /* ============ plain page (no WebGL, reduced motion, or chosen) ============ */
  .tier-plain #stage, .tier-plain #loader, .tier-plain .walk-only, .tier-plain .panel-close { display: none !important; }
  html:not(.tier-plain) .plain-only { display: none !important; }
  .tier-plain .topbar { position: sticky; background: linear-gradient(var(--bg) 60%, transparent); }
  .tier-plain #content { max-width: 760px; margin: 0 auto; padding: 0 var(--gutter-r) 80px var(--gutter); display: grid; gap: 72px; }
  .tier-plain .intro { display: grid; grid-template-columns: minmax(160px, 260px) 1fr; gap: 32px; align-items: end; padding-top: 24px; }
  .tier-plain .intro h1 { font-size: clamp(44px, 7vw, 76px); font-weight: 800; letter-spacing: -0.04em; }
  .tier-plain .lede { font-size: 19px; color: var(--fg-2); margin-top: 14px; }
  .tier-plain .me { width: 100%; height: auto; filter: drop-shadow(0 20px 40px var(--shadow)); }
  .gate-links { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 24px; }
  .gate-link { text-decoration: none; border-radius: 18px; padding: 16px; display: grid; gap: 2px; border: 1px solid var(--glass-line); min-height: 44px; }
  .gate-link b { font-family: var(--font-display); font-size: 20px; }
  .gate-link span { font-size: 13.5px; color: var(--muted); }
  .gate-link.human { background: linear-gradient(160deg, rgba(255, 106, 61, 0.22), transparent); }
  .gate-link.tech { background: linear-gradient(160deg, rgba(113, 130, 255, 0.24), transparent); }
  .tier-plain .world { display: grid; gap: 56px; }
  .world-h { font-size: clamp(48px, 8vw, 96px); font-weight: 800; letter-spacing: -0.045em; }
  .world.human .world-h { color: var(--warm-soft); } .world.tech .world-h { color: var(--cool-soft); }
  .tier-plain .foot { color: var(--muted); font-size: 13px; }
  @media (max-width: 600px) {
    .tier-plain .intro { grid-template-columns: 1fr; }
    .tier-plain .me { max-width: 200px; }
    .gate-links { grid-template-columns: 1fr; }
    .menu-in { grid-template-columns: 1fr; gap: 24px; }
    .logo span { display: none; }
  }

  /* ============ the walk (3D and 2.5D) ============ */
  html.tier-3d, html.tier-25d { height: 100%; }
  .tier-3d body, .tier-25d body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .tier-3d #pics, .tier-25d #three { display: none; }
  #stage { position: fixed; inset: 0; z-index: 0; background: var(--bg); }
  #three { width: 100%; height: 100%; display: block; touch-action: none; }

  #loader { position: fixed; inset: 0; z-index: 100; background: var(--bg); display: grid; place-content: center; justify-items: center; gap: 10px; color: var(--muted); transition: opacity 0.9s, visibility 0.9s; }
  #loader .count { font-variant-numeric: tabular-nums; font-size: 44px; color: var(--fg); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; }
  #loader.done { opacity: 0; visibility: hidden; }

  #hud { position: fixed; inset: 0; z-index: 30; pointer-events: none; }
  #hud > * { pointer-events: auto; }
  #hotspots, #hud > #gates { pointer-events: none; }

  /* hotspots pinned to ui_anchor_<stop> */
  #hotspots { position: absolute; inset: 0; }
  .hot { position: absolute; left: 0; top: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; padding: 0; border: 0; background: none; cursor: pointer; display: none; pointer-events: auto; }
  body[data-world='human'] .hot.human, body[data-world='tech'] .hot.tech { display: block; }
  .tier-25d .hot, .hot.off { display: none !important; }
  .ring { position: absolute; inset: 11px; border-radius: 50%; border: 2px solid var(--light); box-shadow: 0 0 18px currentColor, inset 0 0 10px currentColor; }
  .ring::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid currentColor; animation: ping 2.4s ease-out infinite; }
  .hot.human { color: var(--warm-soft); } .hot.tech { color: var(--cool-soft); }
  .hot.active .ring { background: currentColor; }
  @keyframes ping { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  .tip { position: absolute; left: 50%; top: -6px; transform: translate(-50%, -100%); white-space: nowrap; font: 600 12.5px var(--font-body); color: var(--light); padding: 4px 9px; border-radius: 8px; background: var(--shade); opacity: 0; transition: opacity 0.25s; pointer-events: none; }
  .hot:hover .tip, .hot:focus-visible .tip, .hot.active .tip { opacity: 1; }
  body[data-moving] .hot { opacity: 0.35; }

  /* gate buttons: pinned to the gates in 3D, a row at the bottom otherwise */
  #gates { position: absolute; left: 0; right: 0; bottom: calc(max(22px, env(safe-area-inset-bottom, 0px)) + 70px); display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 0 12px; }
  body:not([data-place='threshold']) #gates, body[data-moving] #gates { visibility: hidden; }
  .gate { pointer-events: auto; display: grid; gap: 2px; justify-items: center; text-align: center; padding: 12px 20px; border-radius: 22px; border: 1px solid var(--glass-line); background: var(--glass); color: var(--fg);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); cursor: pointer; min-height: 44px; transition: background 0.25s, color 0.25s, transform 0.2s; }
  .gate b { font: 800 clamp(17px, 1.7vw, 24px) var(--font-display); letter-spacing: -0.02em; }
  .gate em { font: 400 13px var(--font-body); font-style: normal; color: var(--fg-2); }
  .gate.human:hover, .gate.human:focus-visible { background: var(--warm); color: var(--ink); }
  .gate.tech:hover, .gate.tech:focus-visible { background: var(--cool); color: var(--ink); }
  .gate:hover em, .gate:focus-visible em { color: inherit; }
  #gates.pinned { inset: 0; bottom: auto; display: block; padding: 0; }
  #gates.pinned .gate { position: absolute; left: 0; top: 0; translate: -50% -50%; }

  /* Anthony's bubble */
  #bubble { position: absolute; left: 50%; bottom: calc(max(22px, env(safe-area-inset-bottom, 0px)) + 150px); translate: -50% 0; width: min(360px, calc(100vw - 24px));
    padding: 18px 18px 16px; border-radius: 22px 22px 22px 6px; background: var(--paper); color: var(--ink); box-shadow: 0 24px 60px var(--shadow); max-height: 60svh; overflow-y: auto; }
  #bubble.pinned { left: clamp(12px, calc(var(--hx) - 180px), calc(100vw - 372px)); bottom: calc(100svh - var(--hy) + 6px); translate: 0 0; max-height: max(180px, calc(var(--hy) - 84px)); border-radius: 22px; }
  #bubble.in { animation: rise 0.35s var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  #bubble .who { font: 600 12px var(--font-body); color: var(--ink-muted); margin-bottom: 4px; }
  #bubble .lines { display: grid; gap: 6px; font-size: 16px; line-height: 1.45; padding-right: 26px; }
  #bubble .choices { display: grid; gap: 6px; margin-top: 14px; }
  #bubble .choice { text-align: left; font: 600 14.5px var(--font-body); color: var(--ink); background: rgba(21, 20, 26, 0.06); border: 1px solid rgba(21, 20, 26, 0.12); border-radius: 14px; padding: 10px 12px; min-height: 44px; cursor: pointer; }
  #bubble .choice:hover { background: rgba(21, 20, 26, 0.12); }
  #bubble .choice.warm { background: var(--warm); border-color: var(--warm); }
  #bubble .choice.cool { background: var(--cool); border-color: var(--cool); }
  #bubble .close { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-radius: 50%; background: none; color: var(--ink); cursor: pointer; }
  #bubble .close:hover { background: rgba(21, 20, 26, 0.08); }
  #bubble :focus-visible { outline-color: var(--ink); }
  #ask { position: absolute; left: max(18px, env(safe-area-inset-left, 0px)); bottom: calc(max(22px, env(safe-area-inset-bottom, 0px)) + 4px); display: flex; align-items: center; gap: 8px; padding: 4px 14px 4px 6px;
    border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); color: var(--fg); font: 600 13px var(--font-body); cursor: pointer; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); min-height: 44px; }
  #ask img { width: 28px; height: 36px; object-fit: cover; object-position: top; border-radius: 50%; background: var(--light-12); }

  /* chapter dots */
  #walknav { position: absolute; left: 50%; translate: -50% 0; bottom: max(22px, env(safe-area-inset-bottom, 0px)); display: flex; align-items: center; gap: 8px;
    padding: 6px; border-radius: 999px; background: var(--glass); border: 1px solid var(--glass-line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); max-width: calc(100vw - 32px); }
  .arrow { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--light-12); color: var(--fg); cursor: pointer; flex: none; }
  .arrow:hover { background: var(--light-20); }
  .arrow:disabled { opacity: 0.35; cursor: default; }
  .dots { display: none; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  body[data-world='human'] .dots.human, body[data-world='tech'] .dots.tech { display: flex; }
  .dots button { flex: none; font: 500 12.5px var(--font-body); color: var(--fg-2); background: none; border: 0; padding: 0 11px; min-height: 36px; border-radius: 999px; cursor: pointer; white-space: nowrap; }
  .dots button:hover { color: var(--fg); }
  .dots button[aria-current='true'] { color: var(--ink); background: var(--fg); }
  .dots.human button[aria-current='true'] { background: var(--warm); }
  .dots.tech button[aria-current='true'] { background: var(--cool); }
  .at-gate { display: none; font: 500 12.5px var(--font-body); color: var(--fg-2); padding: 0 10px; }
  body[data-place='threshold'] .at-gate { display: block; }
  #hint { position: absolute; left: 0; right: 0; text-align: center; top: max(76px, calc(env(safe-area-inset-top, 0px) + 64px)); color: var(--light-60); font-size: 12.5px; transition: opacity 0.6s; }
  body:not([data-place='threshold']) #hint, body[data-moving] #hint { opacity: 0; }

  /* the info panel: one at a time */
  .tier-3d #content, .tier-25d #content { position: fixed; z-index: 20; right: max(24px, env(safe-area-inset-right, 0px)); top: 50%; translate: 0 -50%; width: min(440px, 40vw); max-height: calc(100svh - 200px);
    overflow-y: auto; overscroll-behavior: contain; padding: 28px; border-radius: 24px; background: var(--glass); border: 1px solid var(--glass-line);
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3); box-shadow: 0 30px 80px var(--shadow); scrollbar-width: thin; scrollbar-color: var(--light-20) transparent;
    transition: opacity 0.35s, translate 0.45s var(--ease); }
  .tier-3d body[data-panel='closed'] #content, .tier-25d body[data-panel='closed'] #content, .tier-3d body[data-moving] #content, .tier-25d body[data-moving] #content { opacity: 0; translate: 16px -50%; pointer-events: none; visibility: hidden; }
  .tier-3d #content > *, .tier-25d #content > * { display: none; }
  .tier-3d #content > .world, .tier-25d #content > .world { display: contents; }
