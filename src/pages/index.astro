---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StopPanel from '../components/StopPanel.astro';

const stops = (await getCollection('stops')).sort((a, b) => a.data.order - b.data.order);
const people = stops.filter((s) => s.data.world === 'people');
const tech = stops.filter((s) => s.data.world === 'technology');
---
<Base>
  <!-- the world -->
  <picture class="art-fallback" aria-hidden="true">
    <source media="(max-aspect-ratio: 9/10)" srcset="scenes/gate-tall.jpg" />
    <img src="scenes/gate-wide.jpg" alt="" />
  </picture>
  <canvas id="scene" aria-hidden="true"></canvas>
  <canvas id="fx" aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>

  <div id="loader" aria-hidden="true">
    <span>Opening the gates</span>
    <span class="count" id="load-n">0%</span>
  </div>

  <!-- top bar -->
  <header class="topbar">
    <a class="logo" href="#gate" data-go="gate"><i aria-hidden="true"></i><span>Anthony Toshev</span></a>
    <div class="top-r">
      <a class="quick" href="#stop-t5-crystal">Start a brief</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <i></i><i></i><i></i>
      </button>
    </div>
  </header>

  <!-- at the gate -->
  <section class="gate-ui" id="gate" aria-label="Choose a gate">
    <h1 class="sr-only">Anthony Toshev: people and technology</h1>
    <a class="half left" href="#people" data-go="people" aria-label="Enter the People gate: coaching, events, teambuildings">
      <span class="gate-label" id="label-people"><b>People</b><em>coaching, events, teambuildings</em></span>
    </a>
    <a class="half right" href="#technology" data-go="technology" aria-label="Enter the Technology gate: websites, custom builds, AI automations">
      <span class="gate-label" id="label-tech"><b>Technology</b><em>websites, custom builds, AI</em></span>
    </a>
    <div class="pill" role="group" aria-label="Pick a gate">
      <a href="#people" data-go="people">People</a>
      <i aria-hidden="true"></i>
      <a href="#technology" data-go="technology">Technology</a>
    </div>
    <p class="hint" aria-hidden="true">Walk through a gate. Arrow keys and swipes work too.</p>
  </section>

  <!-- inside a world -->
  <section class="world-ui" id="world" aria-label="World">
    <button class="back" type="button" id="back">Back through the gate</button>
    <div class="hotspots" id="hotspots">
      {stops.map((s) => (
        <a class={`hot ${s.data.world}`} href={`#stop-${s.id}`} data-stop={s.id} data-world={s.data.world} data-x={s.data.x} data-y={s.data.y}>
          <span class="ring" aria-hidden="true"></span><span class="tip">{s.data.place}</span>
        </a>
      ))}
    </div>
    <div class="dock" id="dock">
      {people.map((s, i) => <StopPanel stop={s} index={i} total={people.length} />)}
      {tech.map((s, i) => <StopPanel stop={s} index={i} total={tech.length} />)}
    </div>
    <nav class="stops-nav" aria-label="Places in this world">
      <button type="button" class="arrow" id="prev" aria-label="Previous place"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="dots" id="dots"></div>
      <button type="button" class="arrow" id="next" aria-label="Next place"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
    </nav>
  </section>

  <!-- menu: the fast path -->
  <div class="menu" id="menu" hidden>
    <div class="menu-in">
      <div class="col">
        <a class="mh w" href="#people" data-go="people">People</a>
        {people.map((s) => <a href={`#stop-${s.id}`}><span class="mplace">{s.data.place}</span>{s.data.title}</a>)}
      </div>
      <div class="col">
        <a class="mh c" href="#technology" data-go="technology">Technology</a>
        {tech.map((s) => <a href={`#stop-${s.id}`}><span class="mplace">{s.data.place}</span>{s.data.title}</a>)}
      </div>
      <a class="menu-gate" href="#gate" data-go="gate">Back to the gates</a>
    </div>
  </div>
</Base>

<style is:global>
  html, body { height: 100%; }
  html, body { overflow-x: clip; }
  html.js body { overflow-y: clip; overscroll-behavior: none; touch-action: none; }
  html.js .dock, html.js .menu { touch-action: pan-y; }

  #scene, #fx, .art-fallback, .veil { position: fixed; inset: 0; width: 100%; height: 100%; }
  #scene { z-index: 0; display: block; }
  #fx { z-index: 2; pointer-events: none; }
  .art-fallback { z-index: 0; }
  .art-fallback img { width: 100%; height: 100%; object-fit: cover; }
  html.js.webgl .art-fallback { display: none; }
  .veil { z-index: 1; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, var(--shade)); opacity: 1; transition: background 0.8s; }
  body[data-mode='people'] .veil, body[data-mode='technology'] .veil { background: linear-gradient(90deg, var(--shade-soft) 30%, var(--shade)); }

  /* loader */
  #loader { position: fixed; inset: 0; z-index: 100; background: var(--bg); display: grid; place-content: center; justify-items: center; gap: 10px; color: var(--muted); transition: opacity 0.9s, visibility 0.9s; }
  #loader .count { font-variant-numeric: tabular-nums; font-size: 44px; color: var(--fg); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.03em; }
  html.no-js #loader, #loader.done { opacity: 0; visibility: hidden; }

  /* top bar */
  .topbar { position: fixed; z-index: 40; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center;
    padding: max(14px, env(safe-area-inset-top, 0px)) max(18px, env(safe-area-inset-right, 0px)) 14px max(18px, env(safe-area-inset-left, 0px)); pointer-events: none; }
  .topbar > * { pointer-events: auto; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 16px;
    text-shadow: 0 2px 14px var(--shadow-strong); }
  .logo i { width: 9px; height: 9px; background: var(--warm); box-shadow: 9px 0 0 var(--cool); margin-right: 9px; }
  .top-r { display: flex; align-items: center; gap: 14px; }
  .quick { font: 600 13px var(--font-body); text-decoration: none; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .menu-btn { width: 64px; height: 40px; background: none; border: 0; cursor: pointer; display: grid; align-content: center; justify-items: end; gap: 7px; padding: 0; }
  .menu-btn i { display: block; height: 2px; width: 34px; background: var(--fg); border-radius: 2px; box-shadow: 0 1px 8px var(--light-35); transform-origin: right; transition: transform 0.4s var(--ease), opacity 0.3s; }
  .menu-btn i:nth-child(2) { transform: scaleX(0.76); }
  .menu-btn:hover i:nth-child(2) { transform: scaleX(1); }
  .menu-btn[aria-expanded='true'] i:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] i:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  /* gate */
  .gate-ui { position: fixed; inset: 0; z-index: 10; }
  .half { position: absolute; top: 0; bottom: 0; width: 50%; text-decoration: none; }
  .half.left { left: 0; } .half.right { right: 0; }
  .gate-label { position: absolute; transform: translate(-50%, -100%); display: grid; justify-items: center; gap: 2px; text-align: center; opacity: 1;
    transition: opacity 0.5s, transform 0.6s var(--ease); pointer-events: none; text-shadow: 0 4px 30px var(--shadow-strong); white-space: nowrap; }
  .gate-label b { font-family: var(--font-display); font-weight: 800; font-size: clamp(34px, 4.6vw, 76px); letter-spacing: -0.04em; line-height: 0.9; }
  .gate-label em { font-style: normal; font-size: 15px; color: var(--fg-2); }
  html.js.webgl .gate-label { opacity: 0; }
  html.js.webgl .half:hover .gate-label, .half:focus-visible .gate-label, html.js.webgl body.touch .gate-label { opacity: 1; transform: translate(-50%, -110%); }
  .pill { position: absolute; left: 50%; top: 84%; transform: translate(-50%, -50%); display: flex; align-items: center;
    border-radius: 999px; padding: 4px; border: 1.5px solid var(--ember); background: var(--ember-fill); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0 24px var(--ember-glow), inset 0 0 18px var(--ember-inner); animation: glow 3.2s ease-in-out infinite; white-space: nowrap; }
  .pill a { font: 600 15px var(--font-body); text-decoration: none; padding: 11px 20px; border-radius: 999px; transition: background 0.3s, color 0.3s; }
  .pill a:first-child:hover { background: var(--warm); color: var(--bg); }
  .pill a:last-child:hover { background: var(--cool); color: var(--bg); }
  .pill i { width: 1px; height: 20px; background: var(--ember-dim); }
  @keyframes glow { 50% { box-shadow: 0 0 40px var(--ember-glow-hi), inset 0 0 24px var(--ember-inner); } }
  .hint { position: absolute; left: 0; right: 0; text-align: center; bottom: max(3vh, calc(env(safe-area-inset-bottom, 0px) + 8px)); color: var(--light-60); font-size: 12px; }

  /* world */
  .world-ui { position: fixed; inset: 0; z-index: 10; pointer-events: none; }
  .world-ui > * { pointer-events: auto; }
  body[data-mode='gate'] .world-ui, body:not([data-mode='gate']) .gate-ui { visibility: hidden; }
  html.js body[data-mode='gate'] .world-ui *, html.js body:not([data-mode='gate']) .gate-ui * { pointer-events: none; }
  .back { position: absolute; top: max(70px, calc(env(safe-area-inset-top, 0px) + 60px)); left: max(18px, env(safe-area-inset-left, 0px)); font: 600 13px var(--font-body); color: var(--fg);
    padding: 9px 14px; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); cursor: pointer; }

  .hotspots { position: absolute; inset: 0; pointer-events: none; }
  .hot { position: absolute; left: 0; top: 0; width: 44px; height: 44px; margin: -22px 0 0 -22px; pointer-events: auto; text-decoration: none; display: none; will-change: transform; }
  body[data-mode='people'] .hot.people, body[data-mode='technology'] .hot.technology { display: block; }
  .ring { position: absolute; inset: 10px; border-radius: 50%; border: 2px solid var(--light); box-shadow: 0 0 18px currentColor, inset 0 0 10px currentColor; }
  .ring::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid currentColor; animation: ping 2.2s ease-out infinite; }
  .hot.people { color: var(--warm-soft); } .hot.technology { color: var(--cool-soft); }
  .hot.active .ring { background: currentColor; }
  @keyframes ping { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  .tip { position: absolute; left: 50%; top: -10px; transform: translate(-50%, -100%); white-space: nowrap; font: 600 12px var(--font-body); color: var(--light); padding: 4px 8px; border-radius: 6px;
    background: var(--shade); opacity: 1; transition: opacity 0.3s; }
  html.js .tip { opacity: 0; }
  html.js .hot:hover .tip, html.js .hot:focus-visible .tip, html.js .hot.active .tip { opacity: 1; }

  .dock { position: absolute; right: max(24px, env(safe-area-inset-right, 0px)); top: 50%; transform: translateY(-50%); width: min(440px, 40vw); max-height: calc(100svh - 190px); }
  .panel { display: none; max-height: inherit; overflow-y: auto; overscroll-behavior: contain; padding: 28px; border-radius: 24px; background: var(--glass); border: 1px solid var(--glass-line);
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3); box-shadow: 0 30px 80px var(--shadow); scrollbar-width: thin; scrollbar-color: var(--light-20) transparent; }
  .panel.on { display: block; }

  .stops-nav { position: absolute; left: 50%; transform: translateX(-50%); bottom: max(22px, env(safe-area-inset-bottom, 0px)); display: flex; align-items: center; gap: 10px;
    padding: 6px; border-radius: 999px; background: var(--glass); border: 1px solid var(--glass-line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); max-width: calc(100vw - 32px); }
  .arrow { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--light-12); color: var(--fg); font-size: 16px; cursor: pointer; flex: none; }
  .arrow:hover { background: var(--light-20); }
  .arrow:active, .dots button:active, .back:active, .quick:active, .pill a:active { transform: scale(0.96); }
  .arrow, .dots button, .back, .quick { transition: background-color 0.25s, color 0.25s, transform 0.15s; }
  .dots { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .dots button { flex: none; font: 500 12px var(--font-body); color: var(--muted); background: none; border: 0; padding: 7px 10px; border-radius: 999px; cursor: pointer; white-space: nowrap; }
  .dots button[aria-current='true'] { color: var(--bg); background: var(--fg); }
  body[data-mode='people'] .dots button[aria-current='true'] { background: var(--warm); }
  body[data-mode='technology'] .dots button[aria-current='true'] { background: var(--cool); }

  /* menu */
  .menu { position: fixed; inset: 0; z-index: 35; background: var(--glass-deep); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); overflow-y: auto; }
  .menu-in { max-width: 1000px; margin: 0 auto; padding: 110px max(20px, env(safe-area-inset-right, 0px)) 60px max(20px, env(safe-area-inset-left, 0px)); display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .menu .col { display: grid; gap: 4px; align-content: start; }
  .menu a { text-decoration: none; display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px solid var(--glass-line); font-family: var(--font-display); font-size: 22px; font-weight: 700; }
  .menu a:hover { color: var(--fg-2); }
  .mplace { font: 400 13px var(--font-body); color: var(--muted); }
  .menu .mh { font-size: clamp(36px, 5vw, 60px); font-weight: 800; letter-spacing: -0.04em; border: 0; }
  .menu-gate { grid-column: 1 / -1; border: 0 !important; font-size: 16px !important; color: var(--muted); }

  /* tablet portrait + phones */
  @media (max-width: 820px), (max-aspect-ratio: 9/10) {
    .dock { left: 12px; right: 12px; top: auto; bottom: calc(max(22px, env(safe-area-inset-bottom, 0px)) + 62px); transform: none; width: auto; max-height: 52svh; }
    .panel { padding: 20px; border-radius: 20px; }
    .back { top: max(60px, calc(env(safe-area-inset-top, 0px) + 52px)); padding: 7px 12px; font-size: 12px; }
    .gate-label b { font-size: clamp(18px, 5vw, 48px); }
    .gate-label em { font-size: 11px; white-space: normal; max-width: 40vw; }
    .dots button:not([aria-current='true']) { font-size: 0; width: 10px; height: 10px; padding: 0; background: var(--light-35); }
    .dots { align-items: center; }
    .stops-nav { bottom: max(12px, env(safe-area-inset-bottom, 0px)); }
    .menu-in { grid-template-columns: 1fr; gap: 24px; }
    .quick { padding: 7px 12px; }
    .logo span { display: none; }
    .pill a { padding: 11px 16px; font-size: 14px; }
  }
  @media (max-width: 400px) { .quick { display: none; } }

  /* no JavaScript: a calm, readable page over the picture */
  html.no-js #scene, html.no-js #fx, html.no-js .hotspots, html.no-js .stops-nav, html.no-js .back, html.no-js .hint, html.no-js .menu-btn { display: none; }
  html.no-js .world-ui { position: relative; visibility: visible; pointer-events: auto; }
  html.no-js .gate-ui { position: relative; height: 100vh; }
  html.no-js .dock { position: relative; inset: auto; transform: none; width: auto; max-width: 640px; margin: 0 auto; padding: 0 16px 40px; display: grid; gap: 16px; max-height: none; }
  html.no-js .panel { display: block; max-height: none; }
  html.no-js .gate-label { opacity: 1; }

  @media (prefers-reduced-motion: reduce) { .pill, .ring::after { animation: none; } }
</style>

<script>
  import { initExperience } from '../scripts/experience';
  initExperience();
</script>
