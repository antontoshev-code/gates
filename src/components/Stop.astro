---
/** One stop, as an article. The plain page shows them all in order; the walk shows one at a time as a panel. */
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Ph from './Ph.astro';
import NoteDraw from './NoteDraw.astro';
import Process from './Process.astro';

interface Props { stop: CollectionEntry<'stops'>; total: number; worldLabel: string }
const { stop, total, worldLabel } = Astro.props;
const d = stop.data;
const { Content } = await render(stop);
const projects = d.panel === 'archive' ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order) : [];
const tone = d.world === 'human' ? 'warm' : 'cool';
---
<article class={`stop ${d.world}`} id={stop.id} data-stop={stop.id} aria-labelledby={`t-${stop.id}`}>
  <button class="panel-close" type="button" aria-label="Close panel and look around">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <figure class="shot">
    <picture>
      <source media="(max-width: 700px)" srcset={`pictures/${d.picture}-m.webp`} />
      <img src={`pictures/${d.picture}-d.webp`} alt="" loading="lazy" decoding="async" width="1600" height="900" />
    </picture>
  </figure>
  <p class="meta"><span class={tone === 'warm' ? 'w' : 'c'}>{worldLabel}</span> · {d.place} · {d.order} of {total}</p>
  <h3 id={`t-${stop.id}`} class="ptitle" tabindex="-1">{d.title}</h3>
  <p class="kicker">{d.kicker}</p>
  <p class="sum">{d.summary}</p>
  {d.facts.length > 0 && (
    <ul class="facts">{d.facts.map((f) => <li><Ph text={f} /></li>)}</ul>
  )}
  <div class="more"><Content /></div>
  {d.panel === 'note' && <NoteDraw />}
  {d.panel === 'process' && <Process />}
  {d.panel === 'archive' && (
    <ul class="started">
      {projects.map((p) => (<li><b>{p.data.title}</b> <span class="m">({p.data.verb.toLowerCase()})</span> <Ph text={p.data.line} /></li>))}
    </ul>
  )}
  <a class={`btn ${tone} cta`} href={`#${d.action}`} data-topic={d.enquiry}>{d.cta}</a>
</article>

<style>
  .stop { color: var(--fg); display: grid; gap: 14px; position: relative; min-width: 0; }
  .stop > * { min-width: 0; }
  .meta { font-size: 13.5px; color: var(--muted); }
  .ptitle { font-size: clamp(28px, 2.7vw, 42px); overflow-wrap: break-word; hyphens: auto; font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; outline: none; }
  .kicker { color: var(--fg); font-weight: 600; font-size: 15px; margin-top: -4px; }
  .sum { color: var(--fg-2); font-size: 16px; line-height: 1.6; }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .facts li { font-size: 13.5px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--glass-line); color: var(--fg-2); }
  .more { color: var(--muted); font-size: 14.5px; }
  .more :global(p) { margin: 0; }
  .more:empty { display: none; }
  .started { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14.5px; color: var(--fg-2); }
  .started b { font-family: var(--font-display); }
  .shot { margin: 0; border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--bg-2); }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
</style>
