---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Ph from './Ph.astro';
import NoteDraw from './NoteDraw.astro';
import Process from './Process.astro';
import BriefForm from './BriefForm.astro';

interface Props { stop: CollectionEntry<'stops'>; index: number; total: number }
const { stop, index, total } = Astro.props;
const d = stop.data;
const projects = d.panel === 'contact' ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order) : [];
const tone = d.world === 'people' ? 'w' : 'c';
---
<article class={`panel ${d.world}`} id={`stop-${stop.id}`} data-stop={stop.id} data-world={d.world} data-x={d.x} data-y={d.y} data-place={d.place} aria-labelledby={`t-${stop.id}`}>
  <div class="panel-in">
    <h2 id={`t-${stop.id}`} class="ptitle">{d.title}</h2>
    <p class="meta"><span class={tone}>{d.place}</span>, {index + 1} of {total}. {d.kicker}</p>
    <p class="sum">{d.summary}</p>
    {d.panel === 'note' && <NoteDraw />}
    {d.panel === 'process' && <Process />}
    {d.panel === 'contact' && (
      <ul class="started">
        {projects.map((p) => (<li><b>{p.data.title}</b> <span class="m">({p.data.verb.toLowerCase()})</span> <Ph text={p.data.line} /></li>))}
      </ul>
    )}
    {d.more && <p class="more"><Ph text={d.more} /></p>}
    {d.panel === 'brief' ? <BriefForm /> : <a class={`btn ${d.world === 'people' ? 'warm' : 'cool'}`} href={d.ctaHref}>{d.cta}</a>}
  </div>
</article>

<style>
  .panel { color: var(--fg); }
  .panel-in { display: grid; gap: 16px; }
  .meta { font-size: 13.5px; color: var(--muted); margin-top: -6px; }
  .ptitle { font-size: clamp(30px, 3.4vw, 46px); font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; }
  .sum { color: var(--fg-2); font-size: 16px; line-height: 1.6; }
  .more { color: var(--muted); font-size: 14.5px; }
  .started { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14.5px; color: var(--fg-2); }
  .started b { font-family: var(--font-display); }
</style>
