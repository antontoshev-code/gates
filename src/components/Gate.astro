---
/** The split entrance. Hovered side widens; canvas paints warm light (People) and a reactive pixel grid (Technology). */
---
<div class="gate-wrap pad">
  <div class="wrap">
    <div class="gate" id="gate-split">
      <canvas id="fx" aria-hidden="true"></canvas>
      <a class="side people" href="#people" data-world-link="people">
        <div class="top-row"><span class="px w">← People</span><span class="px m">door 1</span></div>
        <h1 class="split-hero"><span>Talk.</span><span>Feel.</span><span>Move.</span></h1>
        <p class="lede">Coaching, workshops, events and teambuildings. Built on Nonviolent Communication, play and a lot of honesty.</p>
        <div class="row">
          <div class="chips"><span>1:1 coaching</span><span>events</span><span>teambuildings</span></div>
          <span class="enter">Explore ←</span>
        </div>
      </a>
      <a class="side tech" href="#technology" data-world-link="technology">
        <div class="top-row"><span class="px m">door 2</span><span class="px c">Technology →</span></div>
        <h2 class="split-hero"><span>Sites.</span><span>Systems.</span><span>Shipped.</span></h2>
        <p class="lede">Websites that work and AI automations that do the boring bits. For small businesses in Bulgaria and solo founders anywhere.</p>
        <div class="row">
          <div class="chips"><span>WordPress</span><span>custom</span><span>AI agents</span></div>
          <span class="enter">Start a brief →</span>
        </div>
      </a>
    </div>
    <div class="foot"><span class="px">People or technology. One person. Pick a side.</span><span class="mono">← → or swipe</span></div>
  </div>
</div>

<style>
  .gate-wrap { padding-top: 96px; }
  .gate { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: clamp(520px, calc(100svh - 190px), 860px);
    border-radius: 28px; overflow: hidden; border: 1px solid var(--line); transition: grid-template-columns 0.8s var(--ease); }
  .gate:has(.people:hover) { grid-template-columns: 1.3fr 0.7fr; }
  .gate:has(.tech:hover) { grid-template-columns: 0.7fr 1.3fr; }
  #fx { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .side { container-type: inline-size; position: relative; z-index: 1; padding: clamp(22px, 3.6vw, 48px); display: flex; flex-direction: column; gap: 20px; text-decoration: none; min-width: 0; overflow: hidden; }
  .side.tech { border-left: 1px solid var(--line); }
  .top-row { display: flex; justify-content: space-between; gap: 12px; }
  .split-hero { font-size: clamp(34px, 12.2cqi, 120px); font-weight: 800; letter-spacing: -0.045em; text-transform: uppercase; margin-top: auto; line-height: 0.92; }
  .split-hero span { display: block; }
  .people .split-hero span:last-child { color: var(--warm); }
  .tech .split-hero span:last-child { color: var(--cool); }
  .lede { max-width: 40ch; color: var(--fg-2); font-size: clamp(16px, 1.4vw, 19px); }
  .row { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chips span { border: 1px solid var(--line); background: rgba(7, 8, 12, 0.55); backdrop-filter: blur(6px); padding: 5px 11px; border-radius: 999px; font-size: 13px; }
  .enter { font-weight: 600; font-size: 15px; padding: 12px 18px; border-radius: 999px; color: var(--bg); white-space: nowrap; transition: transform 0.4s var(--ease); }
  .people .enter { background: var(--warm); }
  .tech .enter { background: var(--cool); }
  .people:hover .enter { transform: translateX(-4px); }
  .tech:hover .enter { transform: translateX(4px); }
  .foot { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 16px; color: var(--muted); }

  @media (max-width: 720px) {
    .gate, .gate:has(.people:hover), .gate:has(.tech:hover) { grid-template-columns: 1fr; min-height: 0; }
    .side { min-height: 420px; }
    .side.tech { border-left: 0; border-top: 1px solid var(--line); }
    .gate-wrap { padding-top: 120px; }
  }
</style>
