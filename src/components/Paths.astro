---
import { getCollection, render } from 'astro:content';
import Ph from './Ph.astro';
interface Props { world: 'people' | 'technology' }
const { world } = Astro.props;
const offers = (await getCollection('offers', (o) => o.data.world === world && !o.data.draft)).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(offers.map(async (o) => ({ o, more: o.body?.trim() ?? '' })));
const tone = world === 'people' ? 'w' : 'c';
---
<div class={`paths ${world}`}>
  {items.map(({ o, more }) => (
    <a class="path reveal" href={o.data.ctaHref}>
      <div class="n"><span class={`px ${tone}`}>{o.data.kicker}</span><span class="tag px">{o.data.status}</span></div>
      <h3>{o.data.title}</h3>
      <p>{o.data.summary}</p>
      {more && <p class="more"><Ph text={more} /></p>}
      <span class={`go ${tone}`}>{o.data.cta} →</span>
    </a>
  ))}
</div>
<style>
  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .path { position: relative; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; min-height: 400px;
    display: flex; flex-direction: column; gap: 14px; overflow: hidden; text-decoration: none; transition: border-color 0.4s, transform 0.5s var(--ease); }
  .path::before { content: ""; position: absolute; inset: auto -30% -60% -30%; height: 90%; border-radius: 50%; filter: blur(50px); opacity: 0; transition: opacity 0.6s; }
  .people .path::before { background: var(--warm); }
  .technology .path::before { background: var(--cool); }
  .path:hover { transform: translateY(-6px); }
  .path:hover::before { opacity: 0.28; }
  .people .path:hover { border-color: var(--warm); }
  .technology .path:hover { border-color: var(--cool); }
  .path > * { position: relative; }
  .n { display: flex; justify-content: space-between; gap: 8px; color: var(--muted); }
  .tag { border: 1px solid currentColor; border-radius: 4px; padding: 2px 7px; }
  h3 { font-size: clamp(28px, 2.6vw, 40px); font-weight: 700; letter-spacing: -0.03em; margin-top: auto; }
  p { color: #b9b8c0; font-size: 15.5px; line-height: 1.55; }
  .more { max-height: 0; overflow: hidden; transition: max-height 0.5s var(--ease); color: var(--muted); font-size: 14.5px; }
  .path:hover .more, .path:focus-visible .more { max-height: 160px; }
  .go { font-weight: 600; font-size: 15px; }
  @media (max-width: 980px) {
    .paths { grid-template-columns: 1fr; }
    .path { min-height: 0; }
    .more { max-height: none; }
  }
</style>
