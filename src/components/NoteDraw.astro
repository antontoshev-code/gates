---
import { getCollection } from 'astro:content';
const notes = await getCollection('notes');
const first = notes[0];
---
<div class="draw">
  <div class="slip" aria-live="polite" data-notes={JSON.stringify(notes.map((n) => ({ id: n.id, text: n.data.text })))}>
    <span class="px">Note to self · #<span class="slip-n">{first?.id}</span></span>
    <blockquote class="slip-q">{first?.data.text}</blockquote>
    <div class="foot"><span class="mono">write it down. or don't.</span><button class="btn slip-btn" type="button">Draw another ↻</button></div>
  </div>
  <div>
    <div class="label m px">The bridge between both doors</div>
    <h2 class="big split" style="font-size:clamp(36px,5vw,72px)">Note to self</h2>
    <p class="copy">My own app. Half diary, half productivity tool, for reflection, sharing and keeping track of your life. It's where the people side and the code side of me meet.</p>
    <p class="copy"><span class="ph">[screenshot + link / waitlist]</span></p>
    <a class="btn" href="#contact" style="margin-top:22px">Get early access →</a>
  </div>
</div>
<style>
  .draw { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .slip { position: relative; background: var(--fg); color: var(--bg); border-radius: 6px; padding: clamp(28px, 4vw, 48px); min-height: 300px;
    display: flex; flex-direction: column; gap: 18px; transform: rotate(-2deg); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); }
  .slip .px, .slip .mono { color: #6a6b78; }
  blockquote { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3vw, 40px); line-height: 1.08; letter-spacing: -0.02em; }
  .foot { margin-top: auto; display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; }
  .slip-btn { background: var(--bg); color: var(--fg); border-color: var(--bg); }
  .copy { color: var(--fg-2); margin-top: 18px; max-width: 46ch; }
  @media (max-width: 980px) { .draw { grid-template-columns: 1fr; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.slip').forEach((slip) => {
    const notes: { id: string; text: string }[] = JSON.parse(slip.dataset.notes || '[]');
    const q = slip.querySelector('.slip-q')!, n = slip.querySelector('.slip-n')!;
    let i = 0;
    slip.querySelector('.slip-btn')?.addEventListener('click', () => {
      if (notes.length < 2) return;
      let j: number;
      do { j = Math.floor(Math.random() * notes.length); } while (j === i);
      i = j;
      q.textContent = notes[i].text;
      n.textContent = notes[i].id;
    });
  });
</script>
