---
/** Fixed HUD: logo, world switcher, Sofia clock, scene counter, and an always-reachable "Start a brief". */
---
<header class="hud-top pad">
  <div class="wrap bar">
    <a class="logo" href="#gate" data-world-link="gate"><i aria-hidden="true"></i>Anthony Toshev</a>
    <nav class="worlds" aria-label="Worlds">
      <a href="#people" data-world-link="people"><span aria-hidden="true">←</span> People</a>
      <a href="#gate" data-world-link="gate" class="gate-dot" aria-label="Gate"><i></i><i></i></a>
      <a href="#technology" data-world-link="technology">Technology <span aria-hidden="true">→</span></a>
    </nav>
    <div class="right">
      <span class="mono live" id="clock">Sofia</span>
      <span class="lang" title="Bulgarian version coming"><b>EN</b><span>БГ</span></span>
    </div>
  </div>
</header>

<div class="hud-bottom pad" aria-hidden="true">
  <div class="wrap row">
    <span class="mono counter"><span id="scene-i">01</span> / <span id="scene-n">04</span> · <span id="scene-name">Gate</span></span>
    <span class="px keys">← → worlds · ↑ ↓ scenes</span>
  </div>
</div>

<a class="brief-fab" href="#brief" data-world-link="technology" data-target="brief">Start a brief <span aria-hidden="true">→</span></a>

<style>
  .hud-top { position: fixed; top: 0; left: 0; right: 0; z-index: 60; padding-top: env(safe-area-inset-top, 0px);
    background: linear-gradient(var(--bg) 35%, transparent); pointer-events: none; }
  .hud-top * { pointer-events: auto; }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-block: 16px; }
  .logo { font-family: var(--font-display); font-weight: 800; font-size: 18px; text-decoration: none; display: flex; align-items: center; gap: 10px; }
  .logo i { width: 10px; height: 10px; background: var(--warm); box-shadow: 10px 0 0 var(--cool); margin-right: 10px; }
  .worlds { display: flex; align-items: center; gap: 4px; border: 1px solid var(--line); border-radius: 999px; padding: 4px; background: rgba(7, 8, 12, 0.6); backdrop-filter: blur(8px); }
  .worlds a { text-decoration: none; font: 500 13px var(--font-body); padding: 6px 12px; border-radius: 999px; color: var(--muted); transition: color 0.3s, background 0.3s; }
  .worlds a:hover { color: var(--fg); }
  .gate-dot { display: flex; gap: 0; padding: 6px 10px !important; }
  .gate-dot i { width: 8px; height: 8px; background: var(--warm); }
  .gate-dot i + i { background: var(--cool); }
  :global(body[data-world='people']) .worlds a[data-world-link='people'] { background: var(--warm); color: var(--bg); }
  :global(body[data-world='technology']) .worlds a[data-world-link='technology'] { background: var(--cool); color: var(--bg); }
  :global(body[data-world='gate']) .worlds .gate-dot { background: var(--fg); }
  .right { display: flex; justify-content: flex-end; align-items: center; gap: 16px; color: var(--muted); }
  .live::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--warm); margin-right: 8px; vertical-align: middle; animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  .lang { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; font-size: 12px; overflow: hidden; }
  .lang b, .lang span { padding: 3px 9px; }
  .lang b { background: var(--fg); color: var(--bg); }

  .hud-bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 55; padding-bottom: max(14px, env(safe-area-inset-bottom, 0px)); pointer-events: none; }
  .row { display: flex; justify-content: space-between; gap: 16px; color: var(--muted); }
  .counter { background: rgba(7, 8, 12, 0.7); padding: 4px 10px; border-radius: 6px; }

  .brief-fab { position: fixed; z-index: 61; right: max(16px, env(safe-area-inset-right, 0px)); bottom: max(48px, calc(env(safe-area-inset-bottom, 0px) + 40px));
    background: var(--cool); color: var(--bg); text-decoration: none; font: 600 14px var(--font-body); padding: 11px 16px; border-radius: 999px;
    box-shadow: 0 10px 40px rgba(113, 130, 255, 0.35); transition: transform 0.3s var(--ease); }
  .brief-fab:hover { transform: translateY(-3px); }
  :global(body[data-world='people']) .brief-fab { background: var(--fg); box-shadow: none; }
  :global(body[data-world='gate']) .brief-fab { opacity: 0; pointer-events: none; transform: translateY(12px); }
  .brief-fab { transition: transform 0.3s var(--ease), opacity 0.3s; }

  @media (max-width: 820px) {
    .bar { grid-template-columns: 1fr auto; }
    .worlds { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
    .right .live { display: none; }
    .keys { display: none; }
    .hud-bottom { display: none; }
  }
</style>
