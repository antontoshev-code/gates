---
const steps = [
  { k: '01 / listen', t: 'We talk', d: "What you do, who it's for, and what the site has to get people to do." },
  { k: '02 / plan', t: 'I plan', d: 'Pages, words and structure first. Design comes after we agree on the message.' },
  { k: '03 / build', t: 'I build', d: 'You see it while it grows and can change your mind.' },
  { k: '04 / launch', t: 'We launch', d: 'You learn to update it yourself. [support terms]' },
];
import Ph from './Ph.astro';
---
<div class="steps">
  {steps.map((s) => (<div class="step reveal"><b>{s.k}</b><h4>{s.t}</h4><p><Ph text={s.d} /></p></div>))}
</div>
<style>
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .step { padding: 26px 22px; display: grid; gap: 10px; align-content: start; border-right: 1px solid var(--line); }
  .step:first-child { padding-left: 0; } .step:last-child { border-right: 0; }
  b { font-family: var(--font-mono); font-weight: 500; color: var(--cool); font-size: 13px; }
  h4 { font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
  p { color: var(--muted); font-size: 15px; }
  @media (max-width: 980px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .step { border-right: 0; padding-left: 0; border-bottom: 1px solid var(--line); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
