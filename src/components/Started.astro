---
import { getCollection } from 'astro:content';
import Ph from './Ph.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<div class="started">
  {projects.map((p) => (
    <div class="thing reveal">
      <span class="px w">{p.data.verb}</span>
      <h4>{p.data.title}</h4>
      <p><Ph text={p.data.line} /></p>
    </div>
  ))}
</div>
<style>
  .started { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .thing { padding: 24px 20px 24px 0; border-bottom: 1px solid var(--line); display: grid; gap: 6px; }
  h4 { font-size: 24px; font-weight: 700; }
  p { color: var(--muted); font-size: 14.5px; }
  @media (max-width: 980px) { .started { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .started { grid-template-columns: 1fr; } }
</style>
