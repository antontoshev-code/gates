---
interface Props { show?: 'both' | 'people' | 'technology'; id?: string }
const { show = 'both', id } = Astro.props;
---
<div class="contact" id={id}>
  <div class="huge split">Say <span>hi.</span></div>
  <div class={`cgrid ${show}`}>
    {show !== 'technology' && (
      <div class="cbox reveal">
        <span class="px w">← People</span>
        <h4>Write to me like a person.</h4>
        <p>Tell me what you're dealing with, or which event caught your eye. I answer within a couple of days, in English or Bulgarian.</p>
        <p><span class="ph">[booking link / email / Instagram]</span></p>
        <a class="btn warm" href={id ? `#${id}` : "#contact"}>Book a free 20-min call</a>
      </div>
    )}
    {show !== 'people' && (
      <div class="cbox reveal">
        <span class="px c">Technology →</span>
        <h4>Got a project?</h4>
        <p>Fill in the brief and I'll come back with questions and a price range.</p>
        <p><span class="ph">[email for projects]</span></p>
        <a class="btn cool" href="#brief" data-world-link="technology" data-target="brief">Start a brief</a>
      </div>
    )}
  </div>
</div>
<style>
  .huge { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.05em; font-size: clamp(64px, 14vw, 220px); line-height: 0.85; }
  .huge span { color: transparent; -webkit-text-stroke: 1.5px var(--fg); }
  .cgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 40px; }
  .cgrid.people, .cgrid.technology { grid-template-columns: minmax(0, 640px); }
  .cbox { border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; display: grid; gap: 14px; align-content: start; }
  h4 { font-size: 28px; font-weight: 700; }
  p { color: var(--muted); }
  @media (max-width: 820px) { .cgrid { grid-template-columns: 1fr; } }
</style>
