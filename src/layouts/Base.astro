---
import '@fontsource/syne/500.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'Anthony Toshev · People & Technology',
  description = 'Coaching, workshops and teambuildings on one side. Websites and AI automations on the other. Sofia, Bulgaria.',
} = Astro.props;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC || 'https://cloud.umami.is/script.js';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080c" />
    <script is:inline>document.documentElement.classList.replace("no-js","js")</script>
    <link rel="preload" as="image" href="scenes/gate-wide.jpg" media="(min-aspect-ratio: 9/10)" />
    <link rel="preload" as="image" href="scenes/gate-tall.jpg" media="(max-aspect-ratio: 9/10)" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId}></script>}
  </head>
  <body data-mode="gate">
    <slot />
  </body>
</html>
